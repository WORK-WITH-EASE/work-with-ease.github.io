<header class="header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Work with Ease – Startseite"><span>WORK</span><span>WITH <span class="brand-ease">EASE</span></span></a>
    <nav class="desktop-nav" aria-label="Hauptnavigation">{% set mobileMenu = false %}{% include "components/menu.njk" %}</nav>
    <div class="quick-contact" role="group" aria-label="Direkter Kontakt"><button class="booking-contact" data-preview="Unverbindlich sprechen" aria-label="Termin buchen" title="Termin buchen"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18m-12 5 2 2 4-4"/></svg><span>Termin<br>buchen</span></button><a href="mailto:{{ site.email }}" aria-label="E-Mail an Work with Ease" title="E-Mail schreiben"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m5 7 7 6 7-6"/></svg></a><a href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="Work with Ease über WhatsApp kontaktieren (neuer Tab)" title="WhatsApp öffnen"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.7 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.4 3.2 2.3 5.1 5.5 5.5"/></svg></a></div>
    <button class="menu-toggle" aria-controls="mobile-nav" aria-expanded="false"><span>Menü</span><span class="menu-lines" aria-hidden="true"></span></button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile Hauptnavigation" hidden>{% set mobileMenu = true %}{% include "components/menu.njk" %}<button class="mobile-contact" data-preview="Unverbindlich sprechen">Kennenlerngespräch vereinbaren <span aria-hidden="true">↗</span></button>
  </nav>
</header>
